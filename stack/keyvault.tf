# Key Vault holds only what managed identities cannot replace.
#
# Generated by Terraform (therefore also present in the protected state):
#   session-secret           signs Express session cookies
#   entra-client-secret      confidential client for admin sign-in
#   ansible-ssh-private-key  agent -> app VM, readable by the agent only
#
# Third-party secrets are NOT managed here: Terraform manages the vault, not
# values it does not own, so they never reach code, variables or state.
#   tmdb-read-token          set once by pipelines/set-secret.yml
#
# There is no SQL password: Azure SQL is Entra-only.

resource "azurerm_key_vault" "this" {
  #checkov:skip=CKV_AZURE_110:Purge protection would block teardown and re-creation of the demo for 7+ days.
  #checkov:skip=CKV_AZURE_42:Recoverability: soft delete stays on (7 days); purge protection skipped, see above.

  name                = "kv-${local.name}-${random_string.suffix.result}"
  location            = local.location
  resource_group_name = local.rg
  tenant_id           = local.tenant_id
  sku_name            = "standard"

  rbac_authorization_enabled    = true # Azure RBAC, no access policies
  public_network_access_enabled = false
  soft_delete_retention_days    = 7
  purge_protection_enabled      = false

  network_acls {
    default_action = "Deny"
    bypass         = "AzureServices"
  }

  tags = local.tags
}

# The agent writes secrets through the private endpoint (hub -> peering ->
# spoke). It needs a data-plane role on this vault, and Azure RBAC takes a
# moment to propagate before the first write.
resource "azurerm_role_assignment" "agent_kv_secrets_officer" {
  scope                = azurerm_key_vault.this.id
  role_definition_name = "Key Vault Secrets Officer"
  principal_id         = local.agent_principal_id
  principal_type       = "ServicePrincipal"
  description          = "Agent: write secrets from Terraform, read the Ansible SSH key"
}

resource "time_sleep" "kv_rbac_propagation" {
  create_duration = "90s"

  depends_on = [
    azurerm_role_assignment.agent_kv_secrets_officer,
    azurerm_private_endpoint.this,
  ]
}

resource "random_password" "session" {
  length  = 64
  special = false
}

locals {
  secrets = {
    "session-secret"          = { value = random_password.session.result, content_type = "text/plain; express session secret" }
    "entra-client-secret"     = { value = azuread_application_password.movies.value, content_type = "text/plain; entra client secret" }
    "ansible-ssh-private-key" = { value = tls_private_key.ansible.private_key_openssh, content_type = "application/x-pem-file" }
  }
}

resource "azurerm_key_vault_secret" "this" {
  # Literal set: for_each keys must be known and non-sensitive at plan time.
  for_each = toset(["session-secret", "entra-client-secret", "ansible-ssh-private-key"])

  name            = each.key
  value           = local.secrets[each.key].value
  content_type    = local.secrets[each.key].content_type
  key_vault_id    = azurerm_key_vault.this.id
  expiration_date = var.secrets_expire_on
  tags            = local.tags

  depends_on = [time_sleep.kv_rbac_propagation]
}
