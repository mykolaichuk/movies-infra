terraform {
  required_version = ">= 1.9.0"

  required_providers {
    azurerm = {
      source  = "hashicorp/azurerm"
      version = "~> 5.0"
    }
    azuread = {
      source  = "hashicorp/azuread"
      version = "~> 3.0"
    }
    random = {
      source  = "hashicorp/random"
      version = "~> 3.6"
    }
    time = {
      source  = "hashicorp/time"
      version = "~> 0.12"
    }
    tls = {
      source  = "hashicorp/tls"
      version = "~> 4.0"
    }
  }

  # Partial configuration: pipelines/infra.yml passes ../backend.hcl and
  # key=stack.tfstate. Authentication comes from the agent's managed identity
  # (ARM_USE_MSI / ARM_CLIENT_ID in the agent environment).
  backend "azurerm" {}
}
