#cloud-config
# Build agent bootstrap (Ubuntu 24.04, arm64).
# Rendered by Terraform templatefile(): a doubled dollar sign before braces
# escapes a shell variable; a single one inserts a Terraform value.

package_update: true
package_upgrade: true
packages:
  - ca-certificates
  - curl
  - gnupg
  - lsb-release
  - jq
  - unzip
  - bzip2
  - git
  - build-essential
  - python3-venv
  - pipx

users:
  - default
  - name: azdo
    gecos: Azure Pipelines agent
    shell: /bin/bash
    homedir: /home/azdo
    lock_passwd: true
    # deliberately no sudo: pipeline jobs run unprivileged

write_files:
  - path: /opt/bootstrap/install-tools.sh
    owner: root:root
    permissions: "0755"
    content: |
      #!/usr/bin/env bash
      # Toolchain for the infra, configuration and app pipelines.
      # Every tool installs in its own strict child shell: one failing
      # download does not stop the others, and the summary lists what failed.
      set -uo pipefail
      export DEBIAN_FRONTEND=noninteractive
      ARCH="$(dpkg --print-architecture)"   # arm64
      CODENAME="$(lsb_release -cs)"         # noble
      export ARCH CODENAME
      export PIPX_HOME=/opt/pipx PIPX_BIN_DIR=/usr/local/bin

      install_azure_cli() {
        curl -fsSL https://aka.ms/InstallAzureCLIDeb | bash
      }

      install_terraform() {
        curl -fsSL https://apt.releases.hashicorp.com/gpg \
          | gpg --dearmor --yes -o /usr/share/keyrings/hashicorp-archive-keyring.gpg
        echo "deb [arch=$ARCH signed-by=/usr/share/keyrings/hashicorp-archive-keyring.gpg] https://apt.releases.hashicorp.com $CODENAME main" \
          > /etc/apt/sources.list.d/hashicorp.list
        apt-get update
        apt-get install -y terraform
      }

      install_nodejs() {
        curl -fsSL https://deb.nodesource.com/setup_24.x | bash -
        apt-get install -y nodejs
      }

      install_python_clis() {
        pipx install --include-deps ansible-core
        pipx install ansible-lint
        pipx install checkov
      }

      install_ansible_azure() {
        ansible-galaxy collection install azure.azcollection community.general ansible.posix \
          -p /usr/share/ansible/collections
        # pipx 1.4 on Ubuntu 24.04 has no 'inject -r': use the venv's pip directly.
        /opt/pipx/venvs/ansible-core/bin/python -m pip install \
          -r /usr/share/ansible/collections/ansible_collections/azure/azcollection/requirements.txt
      }

      # Release archives instead of install scripts: pinned layout, no curl | bash.
      install_tflint() {
        curl -fsSL -o /tmp/tflint.zip \
          "https://github.com/terraform-linters/tflint/releases/latest/download/tflint_linux_$ARCH.zip"
        unzip -o -q /tmp/tflint.zip -d /usr/local/bin
        rm -f /tmp/tflint.zip
      }

      install_gitleaks() {
        local tag
        tag="$(curl -fsSL https://api.github.com/repos/gitleaks/gitleaks/releases/latest | jq -r .tag_name)"
        curl -fsSL -o /tmp/gitleaks.tgz \
          "https://github.com/gitleaks/gitleaks/releases/download/$tag/gitleaks_$${tag#v}_linux_$ARCH.tar.gz"
        tar -xzf /tmp/gitleaks.tgz -C /usr/local/bin gitleaks
        rm -f /tmp/gitleaks.tgz
      }

      install_sqlcmd() {
        curl -fsSL -o /tmp/sqlcmd.tar.bz2 \
          "https://github.com/microsoft/go-sqlcmd/releases/latest/download/sqlcmd-linux-$ARCH.tar.bz2"
        tar -xjf /tmp/sqlcmd.tar.bz2 -C /usr/local/bin sqlcmd
        rm -f /tmp/sqlcmd.tar.bz2
      }

      failed=()
      for step in install_azure_cli install_terraform install_nodejs install_python_clis \
                  install_ansible_azure install_tflint install_gitleaks install_sqlcmd; do
        echo ">>> $step"
        # A fresh 'bash -e' per step: errexit still applies inside the step,
        # which it would not in an 'if' or '||' context of this shell.
        if ! bash -euo pipefail -c "$(declare -f "$step"); $step"; then
          echo "!!! $step FAILED"
          failed+=("$step")
        fi
      done

      echo ">>> tool check"
      for t in az terraform node npx ansible ansible-lint checkov tflint gitleaks sqlcmd jq; do
        if command -v "$t" >/dev/null; then echo "ok      $t"; else echo "MISSING $t"; fi
      done

      if [ "$${#failed[@]}" -gt 0 ]; then
        echo "Failed steps: $${failed[*]}"
        exit 1
      fi

  - path: /opt/bootstrap/register-agent.sh
    owner: root:root
    permissions: "0700"
    content: |
      #!/usr/bin/env bash
      # Downloads, verifies and registers the Azure Pipelines agent as a
      # systemd service running as the unprivileged 'azdo' user.
      set -euo pipefail

      AGENT_VERSION="${agent_version}"
      AGENT_SHA256="${agent_sha256}"
      AGENT_DIR=/home/azdo/agent
      PKG="vsts-agent-linux-arm64-$AGENT_VERSION.tar.gz"

      mkdir -p "$AGENT_DIR"
      cd /tmp
      curl -fsSL -o "$PKG" "https://download.agent.dev.azure.com/agent/$AGENT_VERSION/$PKG"

      # Supply-chain check: refuse a package that does not match the release hash.
      echo "$AGENT_SHA256  $PKG" | sha256sum --check --strict -

      tar -xzf "$PKG" -C "$AGENT_DIR"
      rm -f "$PKG"
      "$AGENT_DIR/bin/installdependencies.sh"

      # Environment for every job: tools pick up the managed identity of the VM.
      cat > "$AGENT_DIR/.env" <<'ENV'
      ARM_USE_MSI=true
      ARM_CLIENT_ID=${uami_client_id}
      AZURE_CLIENT_ID=${uami_client_id}
      ARM_SUBSCRIPTION_ID=${subscription_id}
      ARM_TENANT_ID=${tenant_id}
      ENV
      sed -i 's/^[[:space:]]*//' "$AGENT_DIR/.env"
      chown -R azdo:azdo "$AGENT_DIR"

      cd "$AGENT_DIR"
      sudo -u azdo ./config.sh --unattended \
        --url "${azdo_org_url}" \
        --auth pat --token "${azdo_pat}" \
        --pool "${azdo_pool}" \
        --agent "${agent_name}" \
        --work _work \
        --replace \
        --acceptTeeEula

      ./svc.sh install azdo
      ./svc.sh start

runcmd:
  # Tools first; a failure here is logged but does not block registration.
  - [bash, -c, "/opt/bootstrap/install-tools.sh > /var/log/agent-tools.log 2>&1 || echo 'tool install failed, see /var/log/agent-tools.log'"]
  - [bash, -c, "/opt/bootstrap/register-agent.sh > /var/log/agent-register.log 2>&1"]
  # Remove the readable copies of the one-time PAT. Root-only copies may remain
  # in provisioning metadata, which is why the PAT is revoked right after bootstrap.
  - [bash, -c, "shred -u /opt/bootstrap/register-agent.sh || true"]
  - [bash, -c, "shred -u /var/lib/cloud/instance/user-data.txt* /var/lib/waagent/CustomData 2>/dev/null || true"]

final_message: "Build agent bootstrap finished after $UPTIME seconds"
